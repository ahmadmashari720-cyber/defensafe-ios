{
	"appId": "com.defensafe.system",
	"appName": "DefenSafe",
	"webDir": "public",
	"server": {
		"url": "https://system.defensafe.com/",
		"cleartext": true,
		"allowNavigation": [
			"system.defensafe.com",
			"*.defensafe.com"
		]
	},
	"ios": {
		"allowsLinkPreview": false,
		"scrollEnabled": true,
		"contentInset": "always"
	},
	"packageClassList": [
		"CAPCameraPlugin",
		"GeolocationPlugin",
		"PreferencesPlugin",
		"NativeBiometric"
	]
}
